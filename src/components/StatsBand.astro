---
// Dark full-bleed stats band. Photo reads as TEXTURE: ILD's golden-hour Texas
// aerial under a 0.72 ink overlay plus a brand-deep duotone layer
// (mix-blend-mode: multiply). Renders ONLY stats with confirmed:true (ILD's
// published numbers: 620 / 0 tax returns / 100+ lenders); fewer than 3
// confirmed = 2-up layout. This is the ONE place the page states numbers.
import { stats } from '../config/site';
import { lqip, imageDims } from '../data/lqip';

const confirmed = stats.filter((s) => s.confirmed);

/** Widest string the counter will show while animating (start or end value). */
const digitsFor = (s: (typeof stats)[number]) => {
  const end = s.value.toFixed(s.decimals).length;
  const start = (s.from ?? 0).toFixed(s.decimals).length;
  return Math.max(end, start);
};

const gridClass =
  confirmed.length < 3
    ? 'grid gap-12 sm:grid-cols-2 max-w-2xl mx-auto'
    : confirmed.length === 3
      ? 'grid gap-12 sm:grid-cols-3 max-w-4xl mx-auto'
      : 'grid gap-12 sm:grid-cols-2 lg:grid-cols-4';
---

<section class="sb-band ground-dark cv-auto relative">
  <div class="sb-media" aria-hidden="true">
    <img
      src="/images/ild-aerial-golden.webp"
      alt=""
      width={imageDims.aerialGolden.width}
      height={imageDims.aerialGolden.height}
      loading="lazy"
      decoding="async"
      style={`background-image:url(${lqip.aerialGolden});background-size:cover;background-position:center;`}
    />
    <div class="sb-ink"></div>
    <div class="sb-duo"></div>
  </div>

  <div class="container-x relative z-10 py-20 text-center lg:py-28">
    <p class="eyebrow sb-eyebrow">01 / By the numbers</p>
    <h2 class="h-section mt-3" data-reveal="clip-up">Three numbers that decide most Texas DSCR deals</h2>

    <div class={`${gridClass} mt-14`} data-stagger>
      {
        confirmed.map((s) => (
          <div class="sb-stat" data-child>
            <p class="whitespace-nowrap">
              <span
                class="stat-number"
                style={`--digits:${digitsFor(s)}`}
                data-counter={s.value}
                data-from={s.from ?? 0}
                data-decimals={s.decimals}
              >
                {s.value.toFixed(s.decimals)}
              </span>
              {s.suffix && <span class={`stat-suffix${s.suffix === '+' ? ' sb-plus' : ''}`}>{s.suffix}</span>}
            </p>
            <p class="sb-label mt-3">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sb-band {
    overflow: hidden;
  }

  .sb-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .sb-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Ink overlay: the photo becomes texture, never a background image fighting
     text. 0.72 + duo 0.78 keeps rooftop texture visible while cream + labels
     measure >= 7:1 on the brightest composite pixel (template pass-3 probe). */
  .sb-ink {
    position: absolute;
    inset: 0;
    background: rgba(26, 20, 24, 0.72);
  }

  /* brand-deep duotone pass so the texture carries the claret identity */
  .sb-duo {
    position: absolute;
    inset: 0;
    background: var(--color-brand-deep);
    mix-blend-mode: multiply;
    opacity: 0.78;
  }

  .sb-eyebrow {
    color: var(--color-amber);
  }

  /* The shared .stat-suffix sizes off the 16px paragraph (it is a sibling of
     .stat-number, not a child), so "+" rendered as a 7px dot. Size it against
     the stat clamp (~0.6x) and raise it so "100+" scans as one figure. */
  .sb-plus {
    font-size: clamp(1.9rem, 3.6vw, 3.3rem);
    font-weight: 800;
    line-height: 1;
    vertical-align: 0.45em;
    margin-left: 0.04em;
  }

  .sb-label {
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(244, 239, 227, 0.66);
  }
</style>
