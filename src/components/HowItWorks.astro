---
// Three numbered steps in a row (desktop) / column (mobile), a stroke-drawn
// connector path (data-draw, desktop only), and ILD's brick-ranch Texas photo
// in an .offset-frame with an LQIP background. Step 2 never names Paul.
import { site, howItWorks, cta } from '../config/site';
import { lqip, imageDims } from '../data/lqip';
import Icon from './Icon.astro';

const steps = howItWorks[site.mode];
---

<section class="ground-mist cv-auto relative">
  <div class="container-x py-20 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
      <div data-reveal="scale-up">
        <p class="eyebrow">03 / How it works</p>
        <h2 class="h-section mt-3">What happens after you check</h2>
        <a href="#start" data-scroll-to="#start" class="btn-ghost mt-8">
          {cta.primary}
          <Icon name="arrow" size={18} />
        </a>
      </div>

      <figure class="hiw-figure" data-reveal="scale-up">
        <span class="offset-frame">
          <img
            src="/images/ild-hero-property.webp"
            alt="Brick ranch rental home in Texas under a live oak"
            width={imageDims.heroProperty.width}
            height={imageDims.heroProperty.height}
            loading="lazy"
            decoding="async"
            style={`background-image:url(${lqip.heroProperty});background-size:cover;background-position:center;`}
          />
        </span>
      </figure>
    </div>

    <div class="relative mt-16 lg:mt-20">
      <svg
        class="hiw-connector"
        viewBox="0 0 1000 64"
        fill="none"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M40 44 C 180 8, 330 56, 500 30 C 570 19, 640 40, 706 30"
          stroke="var(--color-brand)"
          stroke-width="2"
          stroke-linecap="round"
          opacity="0.35"
          data-draw></path>
      </svg>

      <ol class="grid gap-10 md:grid-cols-3 md:gap-8" data-stagger>
        {
          steps.map((step, i) => (
            <li class="hiw-step" data-child data-reveal="scale-up">
              <span class="hiw-num" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="h-step mt-5">{step.title}</h3>
              <p class="prose-body hiw-body mt-2">{step.body}</p>
              {i === steps.length - 1 && (
                <span class="hiw-check" aria-hidden="true">
                  <Icon name="check" size={16} />
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* room for the offset frame's 14px outboard stroke; portrait photo capped
     so it never towers over the heading column */
  .hiw-figure {
    margin: 10px 14px 14px 10px;
    max-width: 22rem;
    justify-self: center;
  }

  @media (min-width: 1024px) {
    .hiw-figure {
      max-width: 24rem;
      justify-self: end;
    }
  }

  .hiw-connector {
    position: absolute;
    top: 4px;
    left: 0;
    width: 100%;
    height: 64px;
    display: none;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .hiw-connector {
      display: block;
    }
  }

  .hiw-step {
    position: relative;
  }

  .hiw-num {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: var(--color-brand);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    box-shadow: 0 8px 18px -8px rgba(92, 31, 46, 0.6);
  }

  .hiw-check {
    position: absolute;
    top: 0;
    left: 38px;
    z-index: 2;
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--color-amber);
    color: var(--color-ink);
    border: 2px solid var(--color-mist);
  }

  .hiw-body {
    font-size: 1rem;
  }
</style>
