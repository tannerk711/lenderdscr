---
// Dark footer: brand block (ILD logo in a white chip: the charcoal roof dies on
// ink), the config Company column, and the legal block. ILD publishes no NMLS,
// so Paul's lead-generator disclaimer (verbatim, legal.disclaimer) carries the
// legal weight. The frontmatter guard throws at BUILD time if any config link
// href is not a pattern that resolves on this build, so a dead footer link can
// never ship. Texas-only client: no state directory column.
import { site, brand, directory, housingPhrase, legal } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  /** Kept for LandingPage's call signature; lender mode renders no disclosure block. */
  disclosureAnchor?: boolean;
}
const { disclosureAnchor = true } = Astro.props;

// ---- build-time link guard (config hrefs only)
const allowedExact = new Set(['/', '/start', '/privacy', '/legal', '/privacy#do-not-sell', '#faq', '#start']);
for (const col of directory.columns) {
  for (const link of col.links) {
    if (!allowedExact.has(link.href)) {
      throw new Error(
        `[Footer] directory link "${link.label}" points at "${link.href}", which does not resolve on this build. ` +
          `Allowed: ${[...allowedExact].join(', ')}.`,
      );
    }
  }
}

const columns = directory.columns;
const isNetwork = site.mode === 'network';

// The landing page (/) carries #start and #faq; on every other page those
// anchors are routed home so they are never dead links.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hasLandingAnchors = path === '/';
const resolveHref = (href: string) =>
  !hasLandingAnchors && (href === '#start' || href === '#faq') ? `/${href}` : href;
---

<footer class="ground-dark cv-auto">
  <div class="container-x pt-16 pb-10 lg:pt-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] lg:gap-16">
      <div>
        {
          brand.logoSrc ? (
            <a href="/" class="ft-logo" aria-label={brand.name}>
              <span class="ft-logo-chip">
                <img src={brand.logoSrc} alt="" class="ft-logo-img" width="220" height="161" loading="lazy" decoding="async" />
              </span>
              <span class="ft-wordmark">{brand.name}</span>
            </a>
          ) : (
            <p class="ft-wordmark">{brand.logoText}</p>
          )
        }
        <p class="ft-tagline mt-3">{brand.tagline}</p>
        {
          brand.phone && (
            <a href={brand.phoneHref} class="ft-phone mt-6">
              <Icon name="phone" size={16} />
              {brand.phone}
            </a>
          )
        }
      </div>

      <nav class="grid gap-10 sm:grid-cols-2" aria-label="Footer">
        {
          columns.map((col) => (
            <div>
              <p class="ft-col-title">{col.title}</p>
              <ul class="mt-4 flex flex-col gap-2">
                {col.links.map((link) => (
                  <li>
                    <a href={resolveHref(link.href)} class="ft-link" data-scroll-to={hasLandingAnchors && link.href.startsWith('#') ? link.href : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <hr class="ft-rule mt-14 mb-10" />

    <div class="ft-legal flex flex-col gap-4">
      {isNetwork && legal.networkNotice && <p>{legal.networkNotice}</p>}
      {isNetwork && legal.advertiserDisclosure && <p id={disclosureAnchor ? 'advertiser-disclosure' : undefined}>{legal.advertiserDisclosure}</p>}
      {!isNetwork && brand.nmls && (
        <p>
          {brand.legalName}, NMLS #{brand.nmls}.{' '}
          <a href={brand.licensingUrl} class="ft-link" rel="noopener">NMLS Consumer Access</a>.
        </p>
      )}
      <p>
        {legal.disclaimer.before}<a href={brand.licensingUrl} class="ft-link" rel="noopener" target="_blank">{legal.disclaimer.linkText}</a>{legal.disclaimer.after}
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <span class="eh-mark" role="img" aria-label={housingPhrase}>
          <Icon name="equal-housing" />
          <span>{housingPhrase}</span>
        </span>
        <p class="ft-device">{legal.deviceLine}</p>
      </div>
      <p class="ft-copyright mt-2">&copy; {site.year} {brand.legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .ft-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-cream);
  }

  /* white chip: the logo's charcoal roof vanishes on ink without it */
  .ft-logo-chip {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .ft-logo-img {
    display: block;
    height: 2.1rem;
    width: auto;
  }

  .ft-wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.008em;
    line-height: 1.15;
    color: var(--color-cream);
  }

  .ft-tagline {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(244, 239, 227, 0.6);
  }

  .ft-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-cream);
    text-decoration: none;
  }

  .ft-phone:hover {
    color: var(--color-amber);
  }

  .ft-col-title {
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* 0.62: 0.5 composited to ~4.4:1 on ink, under AA for 11.5px text */
    color: rgba(244, 239, 227, 0.62);
  }

  .ft-link {
    display: inline-block;
    /* tap comfort: lifts the hit target to ~24px+ without changing the rhythm */
    padding-block: 0.15rem;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.5;
    color: rgba(244, 239, 227, 0.74);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .ft-link:hover {
    color: var(--color-cream);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .ft-rule {
    border: 0;
    height: 1px;
    background: rgba(244, 239, 227, 0.12);
  }

  .ft-legal {
    font-size: 0.78rem;
    line-height: 1.6;
    color: rgba(244, 239, 227, 0.55);
  }

  .ft-legal p {
    max-width: 90ch;
  }

  .ft-legal .ft-link {
    display: inline;
    padding: 0;
    font-size: inherit;
    line-height: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    color: rgba(244, 239, 227, 0.7);
  }

  .ft-device {
    font-size: 0.78rem;
    color: rgba(244, 239, 227, 0.55);
  }

  .ft-copyright {
    font-size: 0.78rem;
    /* 0.58: 0.45 composited to ~3.9:1 on ink, under AA for 12.5px text */
    color: rgba(244, 239, 227, 0.58);
  }
</style>
