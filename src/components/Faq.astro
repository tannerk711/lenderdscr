---
// FAQ accordion: native <details> (keyboard-operable for free), a plus glyph
// that rotates open, six questions from config. Pricing language is confined
// to the one sanctioned answer that lives in site.ts.
import { faqs } from '../config/site';
---

<section id="faq" class="ground-paper cv-auto">
  <div class="container-x py-20 lg:py-28">
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div data-reveal="fade-up">
        <p class="eyebrow">Questions</p>
        <h2 class="h-section mt-3">DSCR loan questions, answered</h2>
      </div>

      <div class="flex flex-col gap-4" data-stagger>
        {
          faqs.map((f) => (
            <details class="card faq-item" data-child data-reveal="fade-up">
              <summary>
                <span class="faq-q">{f.q}</span>
                <span class="faq-plus" aria-hidden="true" />
              </summary>
              <div class="faq-a">
                <p class="prose-body">{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq-item {
    overflow: hidden;
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.4rem;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .faq-plus {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--color-brand-soft);
    transition: rotate 260ms var(--ease-out-quart), background-color 200ms ease;
  }

  .faq-plus::before,
  .faq-plus::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    background: var(--color-brand);
    border-radius: 2px;
  }

  .faq-plus::before {
    width: 12px;
    height: 2px;
  }

  .faq-plus::after {
    width: 2px;
    height: 12px;
  }

  .faq-item[open] .faq-plus {
    rotate: 45deg;
    background: var(--color-brand);
  }

  .faq-item[open] .faq-plus::before,
  .faq-item[open] .faq-plus::after {
    background: var(--color-cream);
  }

  .faq-a {
    padding: 0 1.4rem 1.3rem;
    border-top: 1px solid var(--color-line);
  }

  .faq-a .prose-body {
    padding-top: 1.05rem;
    font-size: 0.98rem;
  }
</style>
