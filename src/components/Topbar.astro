---
// Topbar: thin notice bar + header. Left: ILD logo (on paper, no chip needed)
// + wordmark (>= 480px) + tagline (>= 768px). Middle (>= 768px): the three
// program words, said once here and nowhere else at display size. Right:
// phone (>= 768px) + compact amber CTA to /start.
// Static section: NO data-reveal anywhere here.
import { brand, programs, legal, cta } from '../config/site';
import Icon from './Icon.astro';
---

<header class="topbar ground-paper">
  <p class="tb-notice">{legal.noticeBar}</p>
  <div class="container-x tb-row">
    <a href="/" class="tb-logo" aria-label={brand.name}>
      {brand.logoSrc ? (
        <img src={brand.logoSrc} alt="" class="tb-logo-img" width="220" height="161" decoding="async" fetchpriority="high" />
      ) : null}
      <span class="tb-logo-text">
        <span class="tb-logotext">{brand.logoText}</span>
        <span class="tb-tagline">{brand.tagline}</span>
      </span>
    </a>

    <p class="tb-programs">
      {programs.map((p) => <span class="tb-spec-item">{p}</span>)}
    </p>

    <div class="tb-actions">
      {brand.phone && (
        <a href={brand.phoneHref} class="tb-phone">
          <Icon name="phone" size={16} />
          <span>{brand.phone}</span>
        </a>
      )}
      <a href="#start" data-scroll-to="#start" class="btn-amber tb-cta">{cta.primary}</a>
    </div>
  </div>
</header>

<style>
  .tb-notice {
    margin: 0;
    padding: 0.45rem 1rem;
    background: var(--color-brand);
    color: rgba(233, 242, 248, 0.88);
    text-align: center;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .tb-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--color-line);
  }

  .tb-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-ink);
    flex: 0 1 auto;
    min-width: 0;
  }

  .tb-logo-img {
    display: block;
    height: 2.5rem;
    width: auto;
    flex: none;
  }

  .tb-logo-text {
    display: none;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .tb-logotext {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    line-height: 1.1;
    letter-spacing: -0.008em;
    white-space: nowrap;
  }

  .tb-tagline {
    display: none;
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    line-height: 1.35;
    text-transform: uppercase;
    /* 0.66: 0.58 composited to ~4.3:1 on paper, under AA for 10px text; 0.66 measures ~5.6:1 */
    color: rgba(18, 36, 49, 0.66);
  }

  .tb-programs {
    display: none;
    margin: 0 0 0 auto;
    flex: none;
    white-space: nowrap;
    font-weight: 600;
    font-size: 0.78rem;
    color: rgba(18, 36, 49, 0.62);
    text-align: right;
  }

  /* flex items carry no whitespace, so the dot needs a gap on BOTH sides */
  .tb-spec-item + .tb-spec-item::before {
    content: "\00B7";
    margin-inline: 0.55rem;
    color: var(--color-brand);
    font-weight: 800;
  }

  .tb-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
    flex: none;
  }

  .tb-phone {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-brand);
    text-decoration: none;
    white-space: nowrap;
  }

  .tb-phone:hover {
    color: var(--color-brand-deep);
  }

  /* compact variant of .btn-amber for the header (scoped, unlayered, wins) */
  .tb-cta {
    min-height: 2.75rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.8rem;
    border-radius: 10px;
    white-space: nowrap;
  }

  @media (min-width: 480px) {
    .tb-logo-text {
      display: flex;
    }

    .tb-cta {
      padding: 0.55rem 1.05rem;
      font-size: 0.85rem;
    }
  }

  @media (min-width: 768px) {
    .tb-tagline {
      display: block;
    }

    .tb-phone {
      display: inline-flex;
    }

    .tb-actions {
      margin-left: 0;
    }

    .tb-row {
      gap: 1.25rem;
      padding-block: 0.85rem;
    }

    .tb-logo-img {
      height: 2.9rem;
    }
  }

  @media (min-width: 1024px) {
    .tb-programs {
      display: flex;
    }
  }
</style>
