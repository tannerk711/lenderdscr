---
// Topbar: header only (the government-agency notice bar is CUT, Tanner's
// 2026-09-08 video, mobile and desktop). LeaderOne's shape: ILD logo left,
// the phone number right, on every viewport; the "Check My Eligibility"
// header button is gone (the form is the hero, the number is the header CTA).
// Middle (>= 1024px): the three program words, said once here and nowhere
// else at display size. Slim on phones (52px bar, 32px logo, like LO's).
// Static section: NO data-reveal anywhere here.
import { brand, programs } from '../config/site';
import Icon from './Icon.astro';
---

<header class="topbar ground-paper">
  <div class="container-x tb-row">
    <a href="/" class="tb-logo" aria-label={brand.name}>
      {brand.logoSrc ? (
        <img src={brand.logoSrc} alt="" class="tb-logo-img" width="220" height="161" decoding="async" fetchpriority="high" />
      ) : null}
      <span class="tb-logo-text">
        <span class="tb-logotext">{brand.logoText}</span>
        <span class="tb-tagline">{brand.tagline}</span>
      </span>
    </a>

    <p class="tb-programs">
      {programs.map((p) => <span class="tb-spec-item">{p}</span>)}
    </p>

    {brand.phone && (
      <a href={brand.phoneHref} class="tb-phone">
        <Icon name="phone" size={16} />
        <span>{brand.phone}</span>
      </a>
    )}
  </div>
</header>

<style>
  .tb-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--color-line);
  }

  .tb-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-ink);
    flex: 0 1 auto;
    min-width: 0;
  }

  .tb-logo-img {
    display: block;
    height: 2rem;
    width: auto;
    flex: none;
  }

  .tb-logo-text {
    display: none;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .tb-logotext {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    line-height: 1.1;
    letter-spacing: -0.008em;
    white-space: nowrap;
  }

  .tb-tagline {
    display: none;
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    line-height: 1.35;
    text-transform: uppercase;
    /* 0.66: 0.58 composited to ~4.3:1 on paper, under AA for 10px text; 0.66 measures ~5.6:1 */
    color: rgba(18, 36, 49, 0.66);
  }

  .tb-programs {
    display: none;
    margin: 0 0 0 auto;
    flex: none;
    white-space: nowrap;
    font-weight: 600;
    font-size: 0.78rem;
    color: rgba(18, 36, 49, 0.62);
    text-align: right;
  }

  /* flex items carry no whitespace, so the dot needs a gap on BOTH sides */
  .tb-spec-item + .tb-spec-item::before {
    content: "\00B7";
    margin-inline: 0.55rem;
    color: var(--color-brand);
    font-weight: 800;
  }

  /* the number IS the header CTA: ink, bold, tabular, 44px tap target */
  .tb-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
    flex: none;
    min-height: 2.75rem;
    padding: 0.35rem 0.1rem;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .tb-phone svg {
    color: var(--color-amber);
  }

  .tb-phone:hover {
    color: var(--color-amber);
  }

  @media (min-width: 480px) {
    .tb-logo-text {
      display: flex;
    }
  }

  @media (min-width: 768px) {
    .tb-tagline {
      display: block;
    }

    .tb-row {
      gap: 1.25rem;
      min-height: 4rem;
      padding-block: 0.6rem;
    }

    .tb-logo-img {
      height: 2.6rem;
    }

    .tb-phone {
      font-size: 1.05rem;
      gap: 0.5rem;
    }
  }

  @media (min-width: 1024px) {
    .tb-programs {
      display: flex;
    }

    .tb-phone {
      margin-left: 1.5rem;
    }
  }
</style>
