---
// PMF-model header (2026-08-24): white bar, logo left, "Call:" phone right,
// exactly like the converting dscr.promortgagefunding.com page.
import { brand } from '../config/funnel';
---

<header class="bg-white border-b border-ink/10 relative z-30">
  <div class="max-w-6xl mx-auto px-5 lg:px-10 h-16 sm:h-20 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3">
      <img src={brand.logo} alt={`${brand.name} logo`} class="h-9 sm:h-11 w-auto" width="50" height="36" />
      <span class="hidden sm:inline font-bold text-[1.2rem] tracking-tight text-pine leading-tight">{brand.name}</span>
    </a>
    <a href={brand.phoneHref} class="font-bold text-[0.95rem] sm:text-[1.05rem] text-pine hover:text-ink transition-colors whitespace-nowrap">
      Call: {brand.phone}
    </a>
  </div>
</header>
