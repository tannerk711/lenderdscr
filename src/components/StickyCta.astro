---
// StickyCta: mobile-only fixed bottom bar. Starts hidden; the inline observer
// shows it while #start (the step-1 tiles) is out of view AND the FinalCta
// [data-persist] element is not in view. Toggled ONLY via the hidden attribute
// ([hidden] wins in CSS). Links to #start (the form in the hero).
// `after` (content pages, where the form closes the page): a selector that must
// ALSO be out of view before the bar shows, so the bar never sits under the
// hero's own button and the page does not open on the ask.
import { cta } from '../config/site';

interface Props {
  after?: string;
}

const { after } = Astro.props;
---

<div id="sticky-cta" class="sticky-bar md:hidden" data-after={after} hidden>
  <a href="#start" data-scroll-to="#start" class="btn-amber sticky-btn">{cta.sticky}</a>
</div>

<script>
  try {
    const bar = document.getElementById('sticky-cta');
    const start = document.getElementById('start');
    if (bar && start) {
      const persist = document.querySelector('[data-persist]');
      const gate = bar.dataset.after ? document.querySelector(bar.dataset.after) : null;
      let startIn = true;
      let persistIn = false;
      let gateIn = !!gate;
      const update = () => {
        bar.hidden = startIn || persistIn || gateIn;
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.target === start) startIn = e.isIntersecting;
            else if (e.target === gate) gateIn = e.isIntersecting;
            else persistIn = e.isIntersecting;
          }
          update();
        },
        { threshold: 0 }
      );
      io.observe(start);
      if (persist) io.observe(persist);
      if (gate) io.observe(gate);
    }
  } catch {
    /* the page never breaks because of the sticky bar */
  }
</script>

<style>
  .sticky-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom, 0px));
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
    box-shadow: 0 -10px 30px -18px rgba(18, 36, 49, 0.4);
  }

  .sticky-btn {
    width: 100%;
  }
</style>
