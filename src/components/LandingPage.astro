---
// The composed funnel page (Texas-only, lender mode). Section order:
// Topbar -> HeroForm (#start, static step-1 tiles) -> TrustBand -> StatsBand ->
// Advantages -> HowItWorks -> Faq -> FinalCta -> Footer (+ StickyCta).
// The Marquee section is CUT (claim-text marquees are noise; no partner logos
// exist to replace it). Partners / LenderPicks are network-mode only and stay
// gated off. Every section owns its own ground, reveal carrier and .cv-auto.
import Layout from '../layouts/Layout.astro';
import Topbar from './Topbar.astro';
import HeroForm from './HeroForm.astro';
import TrustBand from './TrustBand.astro';
import Partners from './Partners.astro';
import LenderPicks from './LenderPicks.astro';
import StatsBand from './StatsBand.astro';
import Advantages from './Advantages.astro';
import HowItWorks from './HowItWorks.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import Footer from './Footer.astro';
import StickyCta from './StickyCta.astro';
import { site, seo, hero, lenders } from '../config/site';

const network = site.mode === 'network';

// Mirrors LenderPicks' own render condition: when it renders, IT owns
// id="advertiser-disclosure" and the Footer must not duplicate the id.
const lenderPicksVisible =
  network && (import.meta.env.PROD ? lenders.some((l) => !l.placeholder && l.verified === true) : lenders.length > 0);

const sub = network ? hero.subNetwork : hero.subLender;
---

<Layout title={seo.title} description={seo.description} noindex={false}>
  <Topbar />
  <main id="main">
    <HeroForm h1={hero.h1} sub={sub} />
    <TrustBand />
    {network && <Partners />}
    {network && <LenderPicks />}
    <StatsBand />
    <Advantages />
    <HowItWorks />
    <Faq />
    <FinalCta />
  </main>
  <Footer disclosureAnchor={!lenderPicksVisible} />
  <StickyCta />
  <script>
    import '../scripts/motion.ts';
  </script>
</Layout>
