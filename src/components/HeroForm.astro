---
// The hero IS step 1 (BRIEF section 10, variant B). Static H1 (the LCP element,
// never animated), sub line (desktop only), the #start card with a STATIC step-1
// tile group (three t4 option cards, each an anchor to /start?goal=...), and the
// ONE fine-print line under the card. No island, no hydration: the tiles are
// plain links, so the fold paints with the HTML. Nothing inside #start ever
// receives GSAP / tilt / entrance motion.
import Icon from './Icon.astro';
import { form, goals, legal, housingPhrase } from '../config/site';

interface Props {
  h1: string;
  sub: string;
}

const { h1, sub } = Astro.props;
const phases = form.phases;
---

<section class="relative" aria-labelledby="hero-h1">
  <div class="hero-atmo" aria-hidden="true"></div>

  <div class="container-x relative z-10 pt-5 pb-10 md:pt-14 md:pb-16">
    <div class="mx-auto max-w-4xl text-center">
      <h1 id="hero-h1" class="h-display">{h1}</h1>
      <p class="prose-body mx-auto mt-4 hidden text-center md:block">{sub}</p>
    </div>

    <div id="start" class="card-lg mx-auto mt-5 w-full max-w-[52rem] scroll-mt-4 p-4 sm:p-6 md:mt-9 md:p-8">
      <div class="flex flex-wrap items-center gap-1.5" aria-hidden="true">
        {phases.map((p, i) => (
          <span class={`phase-pill${i === 0 ? ' is-active' : ''}`} data-phase-pill data-phase={p.id}>{p.label}</span>
        ))}
      </div>
      <p class="sr-only" data-step-label>Step 1 of {form.totalSteps}</p>
      <div class="progress-track mt-3" aria-hidden="true">
        <div class="progress-fill" style={`width:${Math.round(100 / form.totalSteps)}%`}></div>
      </div>

      <h2 class="h-step mt-5 text-center md:mt-6" data-step-title>{form.titles.goal}</h2>

      <nav class="tiles mt-4 grid gap-3 md:mt-6 md:grid-cols-3 md:gap-4" aria-label={form.titles.goal} data-step="goal">
        {goals.map((g) => (
          <a href={`/start?goal=${g.value}`} class="opt-card tile" data-value={g.value}>
            <span class="opt-coin" aria-hidden="true">
              <Icon name={g.icon} size={24} />
            </span>
            <span>{g.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <p class="mx-auto mt-4 flex max-w-[52rem] flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-[0.78rem] leading-snug text-ink/60">
      <span>{legal.underForm}</span>
      <span class="eh-mark" role="img" aria-label={housingPhrase}>
        <Icon name="equal-housing" />
        <span>{housingPhrase}</span>
      </span>
    </p>
  </div>
</section>

<style>
  /* Anchors reuse the shared .opt-card look; only the link defaults change here. */
  .tile {
    text-decoration: none;
  }

  .tile:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }
</style>
