---
import '../styles/global.css';
import { brand } from '../config/funnel';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = 'DSCR rental property loans. Qualify on the rent, not your tax returns. Check your eligibility in about a minute with no credit pull.', noindex = false } = Astro.props;
const gtagSnippet = brand.gtagId
  ? `window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', '${brand.gtagId}');`
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Single-family Hanken system (2026-08-24 design pass): Fraunces and
         Fragment Mono removed; Hanken is self-hosted from /public/fonts with
         font-display: optional (see global.css). Preloading the two weights
         the first paint uses gives the font its best shot at the optional
         window without ever blocking or repainting the hero. -->
    <link rel="preload" href="/fonts/hanken-grotesk-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {brand.gtagId && <script is:inline set:html={gtagSnippet} />}
    <!-- gtag.js injected after window load (perf, 2026-08-24): the inline
         snippet above defines gtag() as a dataLayer queue, so config and any
         conversion events fired before the library arrives are queued and
         flushed identically. Same tag, same data, off the critical path. -->
    {brand.gtagId && (
      <script is:inline set:html={`window.addEventListener('load',function(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=${brand.gtagId}';document.head.appendChild(s);});`} />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
