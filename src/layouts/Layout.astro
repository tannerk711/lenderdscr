---
import '../styles/global.css';
import { brand } from '../config/funnel';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = 'DSCR rental property loans. Qualify on the rent, not your tax returns. Check your eligibility in about a minute with no credit pull.', noindex = false } = Astro.props;
const gtagSnippet = brand.gtagId
  ? `window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', '${brand.gtagId}');`
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Self-hosted fonts (perf, 2026-09-07): Google Fonts removed, faces
         declared in global.css. Preload the two Hanken weights the first
         paint uses so they land inside the font-display: optional window. -->
    <link rel="preload" href="/fonts/hanken-grotesk-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {brand.gtagId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${brand.gtagId}`}></script>
    )}
    {brand.gtagId && <script is:inline set:html={gtagSnippet} />}
  </head>
  <body>
    <slot />
  </body>
</html>
