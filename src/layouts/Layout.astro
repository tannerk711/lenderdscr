---
import '../styles/global.css';
import { brand, seo, tracking, leadDelivery } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  /** First-paint font files to preload (same-origin woff2). The LP preloads
   *  Manrope, the one family on this variant; every page passes the same. */
  preloadFonts?: string[];
}

const {
  title = seo.title,
  description = seo.description,
  noindex = false,
  ogImage = '/images/og.jpg',
  preloadFonts = ['/fonts/manrope-latin-wght-normal.woff2'],
} = Astro.props;

// Canonical without a trailing slash (root stays the bare origin + '/').
const site = Astro.site ?? new URL(`https://${brand.domain}`);
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, site).href;
const ogImageAbs = new URL(ogImage, site).href;

// TEST MODE (BRIEF section 3): no gtag at all (no stub, no loader, no
// googletagmanager script). LIVE MODE restores the template's deferred-gtag
// pattern: dataLayer stub + gtag queue in the head, gtag.js injected on window
// load (never in the startup path).
// Indexing is decoupled from lead delivery: test mode forces noindex,nofollow,
// and so does seo.noindexSite (the split-test subdomain, live or not).
const isLive = leadDelivery === 'live';
const gtagId = isLive ? tracking.gtagId : '';
const robots = !isLive || seo.noindexSite ? 'noindex, nofollow' : noindex ? 'noindex' : '';

// Inline head script: (live) dataLayer stub + gtag queue, then first-touch
// attribution (both modes): gclid/utm_* -> sessionStorage.attr_*, landing,
// referrer, and ?qa=1 -> sessionStorage.qa (kept for the live-mode gating).
const headScript = `
${gtagId ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gtagId}');` : ''}
try{
  var ss=window.sessionStorage,p=new URLSearchParams(location.search);
  if(p.get('qa')==='1'){ss.setItem('qa','1');}
  var keys=['gclid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'];
  for(var i=0;i<keys.length;i++){var v=p.get(keys[i]);if(v&&!ss.getItem('attr_'+keys[i])){ss.setItem('attr_'+keys[i],v);}}
  if(!ss.getItem('attr_landing')){ss.setItem('attr_landing',location.pathname+location.search);}
  if(!ss.getItem('attr_referrer')){ss.setItem('attr_referrer',document.referrer||'');}
}catch(e){}
`.trim();

const loadScript = gtagId
  ? `window.addEventListener('load',function(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=${gtagId}';document.head.appendChild(s);});`
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f78b4" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Self-hosted latin variable fonts, font-display: optional (global.css).
         Same-origin preload + optional is the proven text-LCP combo. -->
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <script is:inline set:html={headScript} />
    {loadScript && <script is:inline set:html={loadScript} />}
    <slot name="head" />
  </head>
  <body class="ground-paper">
    <slot />
  </body>
</html>
