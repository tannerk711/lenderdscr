---
import '../styles/global.css';
import { brand, seo, tracking } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title = seo.title,
  description = seo.description,
  noindex = false,
  ogImage = '/images/og.jpg',
} = Astro.props;

// Canonical without a trailing slash (root stays the bare origin + '/').
const site = Astro.site ?? new URL(`https://${brand.domain}`);
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, site).href;
const ogImageAbs = new URL(ogImage, site).href;

// Inline head script: dataLayer stub + gtag queue + first-touch attribution.
// gtag.js itself is injected on window load (never in the startup path).
const gtagId = tracking.gtagId;
const headScript = `
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
${gtagId ? `gtag('js',new Date());gtag('config','${gtagId}');` : ''}
try{
  var ss=window.sessionStorage,p=new URLSearchParams(location.search);
  if(p.get('qa')==='1'){ss.setItem('qa','1');}
  var keys=['gclid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'];
  for(var i=0;i<keys.length;i++){var v=p.get(keys[i]);if(v&&!ss.getItem('attr_'+keys[i])){ss.setItem('attr_'+keys[i],v);}}
  if(!ss.getItem('attr_landing')){ss.setItem('attr_landing',location.href);}
  if(!ss.getItem('attr_referrer')){ss.setItem('attr_referrer',document.referrer||'');}
}catch(e){}
`.trim();

const loadScript = gtagId
  ? `window.addEventListener('load',function(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=${gtagId}';document.head.appendChild(s);});`
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#5c1f2e" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Self-hosted latin variable fonts, font-display: optional (global.css).
         Same-origin preload + optional is the proven text-LCP combo. -->
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline set:html={headScript} />
    {loadScript && <script is:inline set:html={loadScript} />}
  </head>
  <body class="ground-paper">
    <slot />
  </body>
</html>
