---
// Sub-620 hard exit: an honest no with the fastest path back. No webhook, no
// consent capture, no conversion, no motion spine. Keeps template 4's design
// (BRIEF section 6 allows it); the "run it again" links go to /start.
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { brand, notYet, MIN_CREDIT } from '../config/site';

const body = notYet.body.replaceAll('{brand}', brand.name);
const title = `Not yet | ${brand.name}`;
const description = `Below a ${MIN_CREDIT} credit score, the DSCR programs at ${brand.name} can't say yes yet. Five concrete moves that raise a score, and an open door when you cross ${MIN_CREDIT}.`;
---

<Layout title={title} description={description} noindex={true}>
  <Topbar />

  <main>
    <section class="ground-paper relative">
      <div class="container-x py-14 md:py-20">
        <div class="mx-auto max-w-3xl text-center">
          <span class="opt-coin mx-auto mb-6 h-14 w-14" aria-hidden="true">
            <Icon name="gauge2" size={28} />
          </span>
          <p class="eyebrow mb-4">Credit below {MIN_CREDIT}</p>
          <h1 class="h-section">{notYet.heading}</h1>
          <p class="prose-body mx-auto mt-6 text-center">{body}</p>
        </div>
      </div>
    </section>

    <section class="ground-mist border-y border-line">
      <div class="container-x py-14 md:py-20">
        <div class="mx-auto max-w-3xl">
          <p class="eyebrow mb-3 text-center">Five moves that move a score</p>
          <h2 class="h-section text-center">What actually raises it, in order.</h2>

          <ol class="mt-10 grid gap-4">
            {notYet.moves.map((m, i) => (
              <li class="card flex items-start gap-4 p-5 md:gap-5 md:p-6">
                <span class="opt-coin font-display text-lg font-extrabold" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3 class="h-step text-[1.15rem] md:text-[1.25rem]">{m.title}</h3>
                  <p class="mt-2 text-[0.95rem] leading-relaxed text-ink/75">{m.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="ground-paper">
      <div class="container-x py-14 md:py-20">
        <div class="card-lg mx-auto max-w-2xl px-6 py-10 text-center md:px-10 md:py-12">
          <span class="opt-coin mx-auto mb-5" aria-hidden="true">
            <Icon name="house-key" size={22} />
          </span>
          <h2 class="h-step text-[1.5rem] md:text-[1.75rem]">{notYet.comeBack}</h2>
          <p class="mx-auto mt-3 max-w-md text-[0.95rem] leading-relaxed text-ink/70">
            The check takes about a minute and never touches your credit. The door stays open.
          </p>
          <a href="/start" class="btn-amber mt-7">
            Run it again
            <Icon name="arrow" size={18} />
          </a>
          {brand.phone && (
            <p class="mt-6 text-[0.9rem] text-ink/65">
              Questions in the meantime? Call
              <a href={brand.phoneHref} class="link whitespace-nowrap">{brand.phone}</a>.
            </p>
          )}
          <p class="mt-4 text-[0.85rem] text-ink/55">
            Picked the wrong credit range by accident?
            <a href="/start" class="link">Start the check again</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
