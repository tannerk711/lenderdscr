---
// PMF-MODEL PAGE (rebuilt 2026-08-24, Tanner's call).
// Structure, sections, and copy modeled 1:1 on the converting page at
// dscr.promortgagefunding.com (Przemek's, 8.72% conv @ $70/lead baseline):
// H1 -> survey (form IS the hero) -> Why Choose (dark, 3 cards) ->
// lender card on photo band -> Discover If You Qualify -> FAQ (open, 5 Qs)
// -> final CTA -> footer. Claims are Paul's published claims only.
// Reviews section deliberately ABSENT: Paul has no real reviews yet
// (PMF shows real Google reviews; never fabricate). The eligibility
// counter renders only when brand.eligibilityCount holds a REAL number.
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import FunnelForm from '../components/FunnelForm';
import { brand, faqs } from '../config/funnel';
---

<Layout
  title={`DSCR Loans Texas | ${brand.name}`}
  description="DSCR rental property loans for Texas real estate investors. Check your eligibility in about a minute. No tax returns or W-2s, rates from 100+ lenders, no credit impact."
>
  <Topbar />

  <!-- ============ H1 + SURVEY (the form IS the hero) ============ -->
  <section class="bg-white pt-10 pb-14 lg:pt-14 lg:pb-20">
    <div class="max-w-3xl mx-auto px-5">
      <!-- H1 is static (no hero-enter): it is the LCP candidate, and an
           opacity-0 entrance delays the LCP paint on mobile. -->
      <h1 class="text-center font-bold text-pine text-[clamp(1.7rem,4.2vw,2.6rem)] leading-[1.18] tracking-[-0.008em] [text-wrap:balance]">
        DSCR Rental Property Loans for Texas Real Estate Investors
      </h1>

      <div class="mt-8 lg:mt-10 hero-enter hero-enter-1" id="eligibility">
        <div class="bg-paper border border-ink/10 rounded-2xl px-5 py-6 sm:px-8 sm:py-8 shadow-[var(--shadow-card)]">
          <FunnelForm client:load />
        </div>
        <p class="text-center text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-ink/45 mt-4">
          No credit pull · No documents · No obligation
        </p>
        {brand.eligibilityCount && (
          <p class="text-center font-bold text-pine text-[1.05rem] mt-3">
            {brand.eligibilityCount} Investors Checked Their Eligibility!
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- ============ WHY CHOOSE (dark band, 3 cards) ============ -->
  <section class="bg-ink text-cream py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-5 lg:px-10">
      <h2 class="text-center font-bold text-[clamp(1.5rem,3vw,2.1rem)] leading-[1.18] tracking-[-0.008em] mb-10 lg:mb-12">
        Why Choose Our DSCR Investor Loans?
      </h2>
      <div class="grid sm:grid-cols-3 gap-5">
        <div class="bg-ink-2 border border-cream/10 rounded-2xl px-6 py-8 text-center">
          <span class="mx-auto mb-5 w-14 h-14 rounded-full bg-brass-2/10 border border-brass-2/30 text-brass-2 flex items-center justify-center">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <path d="M14 2v6h6" />
              <path d="m9.5 12.5 5 5m0-5-5 5" />
            </svg>
          </span>
          <h3 class="font-bold text-[1.08rem] mb-2.5">No Tax Returns or W-2's Required</h3>
          <p class="text-[0.92rem] leading-relaxed text-cream/70">
            Qualify based on rental income from the property. Perfect for the real estate
            investor who maximizes tax write-offs.
          </p>
        </div>
        <div class="bg-ink-2 border border-cream/10 rounded-2xl px-6 py-8 text-center">
          <span class="mx-auto mb-5 w-14 h-14 rounded-full bg-brass-2/10 border border-brass-2/30 text-brass-2 flex items-center justify-center">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
              <path d="M13 2 3 14h7l-1 8 10-12h-7z" />
            </svg>
          </span>
          <h3 class="font-bold text-[1.08rem] mb-2.5">Fast, Streamlined Closings</h3>
          <p class="text-[0.92rem] leading-relaxed text-cream/70">
            We move fast. Our investor loan team knows exactly what to ask for and what to
            ignore. You close in weeks, not months.
          </p>
        </div>
        <div class="bg-ink-2 border border-cream/10 rounded-2xl px-6 py-8 text-center">
          <span class="mx-auto mb-5 w-14 h-14 rounded-full bg-brass-2/10 border border-brass-2/30 text-brass-2 flex items-center justify-center">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
              <path d="M3 21h18" />
              <path d="M5 21v-8h4v8" />
              <path d="M10.5 21V7h4v14" />
              <path d="M16 21V11h4v10" />
              <path d="m6 6 4-4 3.5 3.5L18 1" />
            </svg>
          </span>
          <h3 class="font-bold text-[1.08rem] mb-2.5">Scale Without Hitting a Ceiling</h3>
          <p class="text-[0.92rem] leading-relaxed text-cream/70">
            There's no limit on your personal debt. That means you can keep buying,
            refinancing, and growing your portfolio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TOP DSCR LENDER (photo band + credibility card) ============ -->
  <section class="relative py-16 lg:py-24 overflow-hidden">
    <img src="/images/aerial-golden.webp" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-white/55"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-5 lg:px-10">
      <h2 class="text-center font-bold text-pine text-[clamp(1.5rem,3vw,2.1rem)] leading-[1.18] tracking-[-0.008em] mb-8 lg:mb-10 [text-shadow:0_1px_10px_rgba(255,255,255,0.85)]">
        Top DSCR Lender For Texas Real Estate Investors
      </h2>
      <div class="bg-white rounded-2xl shadow-[var(--shadow-card)] px-6 py-8 sm:px-10 sm:py-9 grid sm:grid-cols-[auto_1fr] gap-7 sm:gap-10 items-center">
        <div class="text-center sm:w-44">
          <img src={brand.logo} alt={`${brand.name} logo`} class="h-20 w-auto mx-auto" loading="lazy" />
        </div>
        <div>
          <h3 class="font-bold text-[1.15rem] text-ink">{brand.name}</h3>
          <p class="font-bold text-[0.95rem] text-pine mb-4">Top Rated Private Mortgage Lender</p>
          <ul class="grid gap-2 mb-6">
            {[
              'DSCR Purchase and Cash Out Options',
              'Short & Long Term Rentals + Fix and Flips',
              `Rates From ${brand.lenderCount} Lenders`,
              'Same Day Income & Credit Approvals',
              'No Tax Returns Required!',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-[0.95rem] text-ink/80">
                <span class="text-[var(--color-cta)] font-bold mt-[1px]" aria-hidden>✓</span>
                {item}
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap items-center gap-4">
            <a href="#eligibility" class="btn-brass rounded-xl px-6 py-3 text-[0.98rem]">Check Eligibility</a>
            <a href={brand.phoneHref} class="font-bold text-pine hover:text-ink transition-colors">{brand.phone}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DISCOVER IF YOU QUALIFY ============ -->
  <section class="bg-paper-2 border-y border-ink/10 py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-5 lg:px-10 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <h2 class="font-bold text-pine text-[clamp(1.5rem,3vw,2.1rem)] leading-[1.18] tracking-[-0.008em] mb-3">
          Discover If You Qualify for DSCR Financing
        </h2>
        <p class="font-bold text-[var(--color-cta)] text-[1.02rem] mb-5">Instant Qualification Check</p>
        <ul class="grid gap-3 mb-8">
          {[
            'Find out in minutes if you meet the DSCR loan requirements.',
            'No obligation and no impact on your credit score.',
            'Get personalized results tailored to your financial situation.',
          ].map((item) => (
            <li class="flex items-start gap-2.5 text-[0.98rem] text-ink/75 leading-relaxed">
              <span class="text-[var(--color-cta)] font-bold mt-[1px]" aria-hidden>✓</span>
              {item}
            </li>
          ))}
        </ul>
        <a href="#eligibility" class="btn-brass rounded-xl px-7 py-3.5">Check Your Eligibility</a>
      </div>
      <div class="order-first lg:order-none">
        <img
          src="/images/hero-property.webp"
          alt="Texas rental property financed with a DSCR loan"
          class="w-full h-[240px] lg:h-[340px] object-cover rounded-2xl shadow-[var(--shadow-card)]"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ============ FAQ (PMF style: questions open, card per Q) ============ -->
  <section class="bg-paper py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-5 lg:px-10">
      <h2 class="text-center font-bold text-[var(--color-cta)] text-[clamp(1.5rem,3vw,2.1rem)] leading-[1.18] tracking-[-0.008em] mb-10">
        Frequently Asked Questions
      </h2>
      <div class="grid gap-5">
        {faqs.map((f) => (
          <div class="bg-white border border-ink/10 rounded-2xl px-6 py-6 sm:px-8 sm:py-7 shadow-[0_2px_12px_rgba(18,36,49,0.06)]">
            <h3 class="font-bold text-[var(--color-cta)] text-[1.1rem] leading-snug mb-3">{f.q}</h3>
            <p class="text-[0.95rem] leading-relaxed text-ink/70">{f.a}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="#eligibility" class="btn-brass rounded-xl px-8 py-4 text-[1.05rem]">Check Eligibility</a>
      </div>
    </div>
  </section>

  <Footer />

  <!-- ============ MOBILE STICKY CTA ============ -->
  <div
    id="sticky-cta"
    class="lg:hidden fixed bottom-0 inset-x-0 z-40 translate-y-full transition-transform duration-300 ease-out"
  >
    <div class="bg-ink/95 backdrop-blur border-t border-brass-2/30 px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
      <a href="#eligibility" class="btn-brass w-full rounded-xl py-3.5 text-[1.02rem]">
        Check My Eligibility →
      </a>
    </div>
  </div>

  <script>
    // mobile sticky CTA: show when the form card is out of view.
    // Tailwind v4 translate-* utilities use the CSS `translate` property.
    const stickyCta = document.getElementById('sticky-cta');
    const formCard = document.getElementById('eligibility');
    if (stickyCta && formCard && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          stickyCta.style.translate = entry.isIntersecting ? '0 100%' : '0 0';
        },
        { rootMargin: '0px 0px -80px 0px' }
      ).observe(formCard);
    }
  </script>
</Layout>
