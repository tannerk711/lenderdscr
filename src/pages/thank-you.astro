---
// /thank-you: the LeaderOne thank-you clone (BRIEF section 6). Structure,
// spacing, type and palette reproduce _ref/leaderone/thank-you.astro with ILD
// content; the LO palette and the Fraunces + Hanken faces are scoped to this
// page by src/styles/thank-you.css (the LP keeps template 4's claret/amber
// identity and never loads that sheet).
//
// CONVERSATION OPENER, never results delivery. Credit is the only answer the
// form screens, so the H1 claims exactly that (LO's honesty-floor logic). The
// promise sentence is Tanner's verbatim; no email is promised; Paul (and Mike,
// first name only) are named on this page ONLY.
//
// Load path: no React, no GSAP. The H1 is the LCP and never animates. The seal
// draws on with CSS keyframes (reduced motion renders it complete). The name
// and chips fill from sessionStorage['lead-summary'] by an inline script that
// runs while the document parses, with graceful defaults when there is none.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { brand, specialist, tracking, goals, propertyTypes, creditBands, leadDelivery } from '../config/site';
import '../styles/thank-you.css';

// TEST MODE (BRIEF section 3): the conversion code stays but cannot fire.
const isLive = leadDelivery === 'live';

// value -> label maps so a summary that carries only values still reads well
const labels = {
  goals: Object.fromEntries(goals.map((g) => [g.value, g.label])),
  props: Object.fromEntries(propertyTypes.map((p) => [p.value, p.label])),
  credits: Object.fromEntries(creditBands.map((c) => [c.value, c.label])),
};

const title = `Eligibility Check Received | ${brand.name}`;
const description = `Your Texas DSCR eligibility check is in. Keep your phone close: a text from ${brand.phone} is how the conversation starts.`;
---

<Layout
  title={title}
  description={description}
  noindex
  preloadFonts={[
    // Exactly three small files (scripts/instance-fonts.py), ordered by what
    // paints biggest. Every face is font-display: optional, so a face that is
    // not ready at first layout is dropped for the page; fewer and smaller
    // preloads are what raise the cold hit rate, and the roman is warm from
    // /start on the funnel path. tools/thank-you-cold-fonts.mjs measures it.
    '/fonts/hanken-grotesk-latin-wght-normal.woff2',
    '/fonts/fraunces-latin-standard-normal.woff2',
    '/fonts/fraunces-latin-standard-italic.woff2',
  ]}
>
  <!-- GOOGLE ADS CONVERSION (LIVE MODE ONLY). Identical gating to the LeaderOne
       page: fires only with a real submission in sessionStorage (or ?demo=1 for
       Tag Assistant), never on a bare load, never when the session was started
       with ?qa=1 (Layout stores sessionStorage.qa), once per tab. In TEST MODE
       `live` is false, Layout renders no gtag at all, and nothing runs. -->
  <script is:inline define:vars={{ conv: isLive ? tracking.gtagConversion : '', live: isLive }}>
    (function () {
      if (!live) return;
      var hasLead = false;
      var isQa = false;
      try {
        hasLead = !!sessionStorage.getItem('lead-summary');
        isQa = sessionStorage.getItem('qa') === '1';
      } catch (e) {}
      var isDemo = false;
      try {
        isDemo = new URLSearchParams(window.location.search).get('demo') === '1';
      } catch (e) {}
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'thank_you_view', lead: hasLead, demo: isDemo });
      } catch (e) {}
      try {
        var fired = false;
        try { fired = sessionStorage.getItem('conv_fired') === '1'; } catch (e) {}
        if (conv && (hasLead || isDemo) && !isQa && !fired && typeof gtag === 'function') {
          gtag('event', 'conversion', { send_to: conv });
          try { sessionStorage.setItem('conv_fired', '1'); } catch (e) {}
        }
      } catch (e) {}
    })();
  </script>

  <div class="lo">
    <!-- ============ TOPBAR (LO: white, logo left, tag + phone right) ============ -->
    <header class="lo-topbar">
      <div class="lo-topbar-row">
        <a href="/" class="lo-topbar-logo" aria-label={`${brand.name} home`}>
          <!-- no fetchpriority="high" here: this page's LCP is text, and the logo
               must not compete with the optional-display fonts at first render -->
          <img src={brand.logoSrc} alt="" width="220" height="161" decoding="async" />
          <span class="lo-topbar-name">{brand.name}</span>
        </a>
        <div class="lo-topbar-right">
          <span class="lo-topbar-tag"><span class="lo-dot" aria-hidden="true"></span>Texas DSCR loans</span>
          <a href={brand.phoneHref} class="lo-topbar-phone">{brand.phone}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- ============ RESULT HERO ============ -->
      <section class="lo-hero">
        <div class="lo-hairline" aria-hidden="true"></div>
        <div class="lo-wrap lo-wrap-3xl">
          <!-- brass seal -->
          <div class="lo-seal" aria-hidden="true">
            <svg viewBox="0 0 80 80">
              <circle cx="40" cy="40" r="37" fill="none" stroke="var(--lo-brass)" stroke-width="2.5" id="seal-ring" />
              <circle cx="40" cy="40" r="30" fill="var(--lo-pine)" opacity="0.08" />
              <path d="M26 41 l10 10 l19 -21" fill="none" stroke="var(--lo-pine)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" id="seal-check" />
            </svg>
          </div>

          <p class="lo-eyebrow lo-eyebrow-hero">Eligibility check received</p>
          <!-- Honesty floor: credit is the only answer this funnel screens, so
               the headline claims exactly that and nothing more. -->
          <h1 class="lo-display lo-h1">
            <span id="ty-name">Nice work</span>. Your credit clears <em>the DSCR floor.</em>
          </h1>
          <p class="lo-lede">
            Now keep your phone close. <strong>Paul or Mike</strong> will text you from
            <a href={brand.phoneHref}>{brand.phone}</a> to answer any questions you have and,
            if you're interested, run some numbers for you. Save the number so you know it's them.
          </p>

          <!-- scenario chips (filled from sessionStorage; hidden while empty) -->
          <div id="ty-chips" class="lo-chips"></div>
        </div>
      </section>

      <!-- PERSONALIZATION: runs as soon as the hero is parsed (before the band,
           ahead of first paint on a document this small) so the name and chips
           are in the first frame. No summary = the defaults above stand. -->
      <script is:inline define:vars={{ labels }}>
        (function () {
          var summary = null;
          try {
            var raw = sessionStorage.getItem('lead-summary');
            if (raw) summary = JSON.parse(raw);
          } catch (e) {}
          if (!summary || typeof summary !== 'object') return;

          var str = function (v) { return v == null ? '' : String(v).trim(); };

          var first = str(summary.firstName).split(/\s+/)[0];
          var nameEl = document.getElementById('ty-name');
          if (nameEl && first) nameEl.textContent = 'Nice work, ' + first;

          var goal = str(summary.goalLabel) || labels.goals[str(summary.goal)] || '';
          var prop = str(summary.propertyTypeLabel) || labels.props[str(summary.propertyType)] || '';
          var price = str(summary.priceDisplay);
          if (!price && typeof summary.price === 'number') price = '$' + summary.price.toLocaleString('en-US');
          if (!price && str(summary.price) === '3000000+') price = '$3,000,000+';
          var credit = str(summary.credit);
          var chips = [
            goal,
            prop,
            str(summary.state) || 'Texas',
            price,
            credit ? 'Credit ' + (labels.credits[credit] || credit) : '',
          ].filter(Boolean);

          var wrap = document.getElementById('ty-chips');
          if (!wrap) return;
          for (var i = 0; i < chips.length; i++) {
            var chip = document.createElement('span');
            chip.className = 'lo-chip';
            chip.textContent = chips[i];
            wrap.appendChild(chip);
          }
        })();
      </script>

      <!-- ============ WHILE YOU WAIT ============ -->
      <section class="lo-band">
        <div class="lo-wrap lo-wrap-5xl">
          <p class="lo-eyebrow lo-eyebrow-band">While you wait</p>
          <h2 class="lo-display lo-h2">Three things worth doing right now.</h2>

          <div class="lo-cards">
            <div class="lo-card">
              <span class="lo-display lo-num" aria-hidden="true">1</span>
              <h3 class="lo-display">Watch for the text</h3>
              <p>
                It comes from {brand.phone}. If you see a Texas rental inquiry from Paul or
                Mike, that's it. Reply and the conversation starts.
              </p>
            </div>
            <div class="lo-card">
              <span class="lo-display lo-num" aria-hidden="true">2</span>
              <h3 class="lo-display">Have your numbers handy</h3>
              <p>
                Nothing is required yet. The rent, the price, and what you're putting down
                are what turn a quick text into same-day income and credit approval.
              </p>
            </div>
            <div class="lo-card">
              <span class="lo-display lo-num" aria-hidden="true">3</span>
              <h3 class="lo-display">Keep shopping deals</h3>
              <p>
                Once terms are in writing you can write offers sellers take seriously, with
                closings in 15 to 25 days.
              </p>
            </div>
          </div>

          <!-- the human: one card, centered. No NMLS line (none exists). -->
          <div class="lo-human">
            <div class="lo-avatar lo-display" aria-hidden="true">{specialist.name.charAt(0)}</div>
            <div class="lo-display lo-human-name">{specialist.name}</div>
            <div class="lo-label">{specialist.title}</div>
          </div>

          <div class="lo-call">
            <p class="lo-label">Rather not wait?</p>
            <a href={brand.phoneHref} class="lo-display lo-tel">{brand.phone}</a>
          </div>
        </div>
      </section>
    </main>
  </div>

  <Footer />
</Layout>
