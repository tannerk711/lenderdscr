---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/funnel';
---

<Layout title={`Your Numbers Are In | ${brand.name}`} description="Your DSCR pricing request is in. Watch for the text.">
  <Topbar />

  <!-- ============ RESULT HERO ============ -->
  <!-- Verdict is deliberately WITHHELD here (no "you pre-qualify"). The page's one
       job is priming the reply loop: Paul texts first, the lead replies to start.
       Overhaul plan 2026-08-19, Phase 1. Paul is named on THIS page only. -->
  <section class="bg-paper py-20 lg:py-24 relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-brass via-brass-2 to-brass"></div>
    <div class="max-w-3xl mx-auto px-5 lg:px-10 text-center relative z-10">

      <!-- brass seal -->
      <div class="mx-auto w-20 h-20 mb-8 relative">
        <svg viewBox="0 0 80 80" class="w-full h-full">
          <circle cx="40" cy="40" r="37" fill="none" stroke="var(--color-brass)" stroke-width="2.5"
            stroke-dasharray="233" stroke-dashoffset="233" id="seal-ring" />
          <circle cx="40" cy="40" r="30" fill="var(--color-pine)" opacity="0.08" />
          <path d="M26 41 l10 10 l19 -21" fill="none" stroke="var(--color-pine)" stroke-width="4.5"
            stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="46" stroke-dashoffset="46" id="seal-check" />
        </svg>
      </div>

      <p class="eyebrow text-moss mb-5">Pricing request received</p>
      <h1 class="font-display text-[clamp(2.2rem,4.5vw,3.6rem)] leading-[1.05] tracking-tight">
        <span id="ty-name">Your numbers are in.</span>
        <em class="italic text-pine">Paul is pricing your deal now.</em>
      </h1>
      <p class="text-ink/65 text-lg leading-relaxed mt-5 max-w-xl mx-auto">
        Paul Howarth will text you first from {brand.phone}. Reply to that text and the
        conversation starts.
      </p>

      <!-- scenario chips (filled from sessionStorage) -->
      <div id="ty-chips" class="flex flex-wrap justify-center gap-2 mt-7"></div>
    </div>
  </section>

  <!-- ============ WATCH FOR THE TEXT ============ -->
  <section class="bg-paper-2 border-y border-ink/10 py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-5 lg:px-10">
      <div class="text-center mb-10">
        <h2 class="font-display text-[clamp(1.7rem,3vw,2.4rem)] tracking-tight">
          Watch for the text.
        </h2>
        <p class="text-ink/60 mt-3 max-w-xl mx-auto">
          Your pricing options come by text first. When it lands, a reply is all it takes.
          Paul handles the rest.
        </p>
      </div>

      <div class="bg-paper border border-ink/10 rounded-2xl shadow-[var(--shadow-card)] px-8 py-12 text-center">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-ink/45 mb-4">It will come from this number</p>
        <a href={brand.phoneHref} class="font-display text-[clamp(2rem,4vw,3rem)] text-pine hover:text-ink transition-colors">
          {brand.phone}
        </a>
        <p class="text-ink/55 text-sm mt-4">
          Save it so you know it&rsquo;s Paul. Rather talk it through live? Call the same number.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ WHY INVESTORS USE US (published capability proof only) ============ -->
  <section class="bg-paper py-16 lg:py-20 border-b border-ink/10">
    <div class="max-w-5xl mx-auto px-5 lg:px-10">
      <p class="eyebrow text-moss text-center mb-4">While you wait</p>
      <h2 class="font-display text-[clamp(1.7rem,3vw,2.4rem)] tracking-tight text-center mb-12">
        What Paul is pricing your deal against.
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="border border-ink/10 rounded-2xl bg-paper-2 px-6 py-7 text-center">
          <div class="font-display text-[2rem] leading-none text-brass">{brand.lenderCount}</div>
          <div class="text-sm text-ink/65 mt-2.5 leading-snug">Lenders your scenario gets priced across</div>
        </div>
        <div class="border border-ink/10 rounded-2xl bg-paper-2 px-6 py-7 text-center">
          <div class="font-display text-[2rem] leading-none text-brass">Same day</div>
          <div class="text-sm text-ink/65 mt-2.5 leading-snug">Income and credit approval on most files</div>
        </div>
        <div class="border border-ink/10 rounded-2xl bg-paper-2 px-6 py-7 text-center">
          <div class="font-display text-[2rem] leading-none text-brass">{brand.closeRangeDays}</div>
          <div class="text-sm text-ink/65 mt-2.5 leading-snug">Days to close, typical DSCR file</div>
        </div>
        <div class="border border-ink/10 rounded-2xl bg-paper-2 px-6 py-7 text-center">
          <div class="font-display text-[2rem] leading-none text-brass">$0</div>
          <div class="text-sm text-ink/65 mt-2.5 leading-snug">Tax returns and pay stubs required</div>
        </div>
      </div>
      <p class="text-center text-ink/50 text-sm mt-8 max-w-2xl mx-auto leading-relaxed">
        Have your rent numbers and target purchase price handy. Everything else, Paul pulls.
        <a href="/call-prep" class="text-pine underline underline-offset-4 hover:text-ink transition-colors ml-1">See the two-minute prep sheet</a>.
      </p>
    </div>
  </section>

  <!-- ============ WHAT HAPPENS NEXT ============ -->
  <section class="bg-paper py-20 lg:py-24">
    <div class="max-w-5xl mx-auto px-5 lg:px-10">
      <p class="eyebrow text-moss text-center mb-4">What happens next</p>
      <h2 class="font-display text-[clamp(1.8rem,3vw,2.5rem)] tracking-tight text-center mb-14">
        From here, it&rsquo;s three steps to funded.
      </h2>
      <div class="grid sm:grid-cols-3 gap-5">
        <div class="border border-ink/10 rounded-2xl bg-paper-2 p-7">
          <span class="font-display text-[2.2rem] text-brass leading-none">1</span>
          <h3 class="font-display text-lg mt-4 mb-2">Reply to Paul&rsquo;s text</h3>
          <p class="text-sm leading-relaxed text-ink/65">That reply is the green light. Paul prices your scenario across the lender network and comes back with real numbers.</p>
        </div>
        <div class="border border-ink/10 rounded-2xl bg-paper-2 p-7">
          <span class="font-display text-[2.2rem] text-brass leading-none">2</span>
          <h3 class="font-display text-lg mt-4 mb-2">Terms in writing</h3>
          <p class="text-sm leading-relaxed text-ink/65">You get the rate, the leverage, and the cash-to-close on paper, so you can write offers or lock your refi terms with real numbers.</p>
        </div>
        <div class="border border-ink/10 rounded-2xl bg-paper-2 p-7">
          <span class="font-display text-[2.2rem] text-brass leading-none">3</span>
          <h3 class="font-display text-lg mt-4 mb-2">Appraisal to funding</h3>
          <p class="text-sm leading-relaxed text-ink/65">Appraisal with a rent schedule, title, done. No tax returns, no pay stubs, no employment verification anywhere in the file.</p>
        </div>
      </div>

      <!-- specialist -->
      <div class="mt-14 max-w-md mx-auto text-center border border-ink/10 rounded-2xl bg-paper-2 px-8 py-8">
        <div class="w-14 h-14 rounded-full bg-pine text-cream font-display text-xl flex items-center justify-center mx-auto mb-4" id="specialist-initial">
          {brand.specialist.name.charAt(0)}
        </div>
        <div class="font-display text-lg">{brand.specialist.name}</div>
        <div class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-ink/50 mt-1.5">
          {brand.specialist.title}{brand.specialist.nmls ? ` · ${brand.specialist.nmls}` : ''}
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    import gsap from 'gsap';
    import { brand } from '../config/funnel';

    // personalize from the form summary
    let hasLead = false;
    try {
      const raw = sessionStorage.getItem('lead-summary');
      if (raw) {
        hasLead = true;
        const s = JSON.parse(raw);
        if (s.firstName) {
          const el = document.getElementById('ty-name');
          const first = String(s.firstName).trim().split(/\s+/)[0];
          if (el) el.textContent = `${first}, your numbers are in.`;
        }
        const labels: Record<string, string> = {
          purchase: 'Purchase', refinance: 'Refinance', cashout: 'Cash-out refi', bridge: 'Fix & flip',
          sfr: 'Single family', '2-4': '2–4 units', '5-9': '5–9 units', '10+': '10+ units',
          commercial: 'Commercial', other: 'Other property',
        };
        const price = typeof s.price === 'number'
          ? s.price >= 2_000_000 ? '$2M+' : `$${Number(s.price).toLocaleString()}`
          : null;
        const chips = [labels[s.goal], labels[s.propertyType], s.city || s.state, price, s.credit ? `Credit ${s.credit}` : null].filter(Boolean);
        const wrap = document.getElementById('ty-chips');
        if (wrap) {
          chips.forEach((c) => {
            const span = document.createElement('span');
            span.className = 'font-mono text-[0.62rem] uppercase tracking-[0.14em] bg-pine/10 text-pine border border-pine/20 rounded-full px-3 py-1.5';
            span.textContent = String(c);
            wrap.appendChild(span);
          });
        }
      }
    } catch { /* fine */ }

    // seal animation
    gsap.to('#seal-ring', { strokeDashoffset: 0, duration: 1.1, ease: 'power2.inOut', delay: 0.2 });
    gsap.to('#seal-check', { strokeDashoffset: 0, duration: 0.7, ease: 'power2.out', delay: 1.0 });

    // Google Ads conversion. Gated: fires for real submissions (lead-summary in
    // sessionStorage) and the ?demo=1 preview (Tag Assistant verification), never
    // on bare visits, so bots and accidental loads do not inflate conversions.
    const isDemo = new URLSearchParams(window.location.search).get('demo') === '1';
    if (brand.gtagConversion && (hasLead || isDemo) && typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'conversion', { send_to: brand.gtagConversion });
    }
  </script>
</Layout>
